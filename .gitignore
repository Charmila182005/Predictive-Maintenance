# ─────────────────────────────────────────────
# Data files (keep folder structure, ignore large files)
# ─────────────────────────────────────────────
# Raw source files — never commit
data/raw/
# Processed / interim outputs — never commit
data/processed/
data/interim/
# Large binary / tabular formats anywhere under data/
data/**/*.csv
data/**/*.tsv
data/**/*.parquet
data/**/*.feather
data/**/*.h5
data/**/*.hdf5
data/**/*.zip
data/**/*.tar.gz
data/**/*.gz
# Scoped JSON exclusion: only exclude large JSON dumps in raw & processed;
# small metadata JSON files at data/ root (e.g. dataset_info.json) ARE tracked.
data/raw/**/*.json
data/processed/**/*.json

# ─────────────────────────────────────────────
# Logs & outputs
# ─────────────────────────────────────────────
logs/
*.log
runs/
mlruns/
outputs/
artifacts/

# TypeScript build cache
*.tsbuildinfo
