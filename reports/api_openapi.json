      "SensorReading": {
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "L",
              "M",
              "H"
            ],
            "title": "Product Type"
          },
          "air_temperature": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Air Temperature",
            "description": "Absolute air temperature in kelvin; broad pilot interface bound, training-range warnings apply"
          },
          "process_temperature": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Process Temperature",
            "description": "Absolute process temperature in kelvin; broad pilot interface bound, training-range warnings apply"
          },
          "rotational_speed": {
            "type": "number",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Rotational Speed",
            "description": "Rotational speed in rpm; broad pilot interface bound"
          },
          "torque": {
            "type": "number",
            "maximum": 1000000000.0,
            "minimum": 0.0,
            "title": "Torque",
            "description": "Torque magnitude in Nm; broad pilot interface bound"
          },
          "tool_wear": {
            "type": "number",
            "maximum": 1000000000.0,
            "minimum": 0.0,
            "title": "Tool Wear",
            "description": "Accumulated tool wear in minutes; broad pilot interface bound"
          },
          "machine_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.: -]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Machine Id"
          },
          "event_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Timestamp"
          },
          "production_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "running",
                  "idle",
                  "down",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Production State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_type",
          "air_temperature",
          "process_temperature",
          "rotational_speed",
          "torque",
          "tool_wear"
        ],
        "title": "SensorReading"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
